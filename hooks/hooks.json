{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-dangerous.sh\"", "timeout": 5 }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-dashes.sh\"", "timeout": 5 }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-save-reminder.sh\"", "timeout": 5 }]
      },
      {
        "matcher": "auto",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-save-reminder.sh\"", "timeout": 5 }]
      }
    ]
  }
}
